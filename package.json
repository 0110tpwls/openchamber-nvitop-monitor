{
  "name": "openchamber-nvitop-monitor",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "description": "Read-only NVIDIA GPU and process monitor for OpenChamber, powered by nvitop",
  "scripts": {
    "build": "esbuild panel/main.mjs --bundle --format=iife --platform=browser --minify --legal-comments=inline --outfile=panel/main.js",
    "test": "node --test && python3 -m unittest discover -s test",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "@openchamber/sdk": "2.6.0",
    "esbuild": "0.28.2"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.0.1"
    },
    "contributes": {
      "panel": {
        "id": "openchamber-nvitop",
        "name": "nvitop GPU Monitor",
        "icon": "icon.svg",
        "entry": "panel/index.html"
      },
      "page": true,
      "statusSection": {
        "entry": "panel/index.html",
        "title": "nvitop GPU Monitor",
        "height": 130
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "permissions": {
          "exec": [
            "python3"
          ]
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0110tpwls/openchamber-nvitop-monitor.git"
  }
}
